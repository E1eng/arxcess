{
  "name": "arxcess",
  "private": true,
  "workspaces": [
    "frontend",
    "sdk/ts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "build:contracts": "cargo build --manifest-path contracts/programs/arxcess/Cargo.toml",
    "build:anchor": "anchor build --provider.cluster Devnet --provider.wallet ~/.config/solana/id.json",
    "lint": "npm run lint --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
